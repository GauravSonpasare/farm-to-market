# Database
DATABASE_URL=postgresql://user:password@hostname:5432/dbname

# Session
SESSION_SECRET=your_super_secret_session_key

# Sever Port
PORT=3000

# Razorpay Keys (Get from dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyId
RAZORPAY_KEY_SECRET=YourTestKeySecret

# Vite / Frontend Variables (must be prefixed with VITE_)
VITE_RAZORPAY_KEY_ID=rzp_test_YourTestKeyId

FIREBASE_CLIENT_EMAIL=dummy_email
FIREBASE_PRIVATE_KEY="dummy_key"

# Frontend Firebase 
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
